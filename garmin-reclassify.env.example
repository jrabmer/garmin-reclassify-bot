# Copy to /etc/garmin-reclassify.env and fill in.
# This file should be owned by root, mode 600, since it holds your password:
#   sudo chown root:root /etc/garmin-reclassify.env
#   sudo chmod 600 /etc/garmin-reclassify.env

GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=yourpassword

# Find this via: python reclassify.py --list-types
TARGET_TYPE_KEY=

# At least one of these two is required.
SOURCE_MATCH_NAME=
SOURCE_TYPE_KEY=

# Optional tuning:
# LOOKBACK_HOURS=26
# DRY_RUN=1
